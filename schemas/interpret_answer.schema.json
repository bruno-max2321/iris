{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iris.local/schemas/interpret_answer.schema.json",
  "title": "Iris interpretation answer",
  "description": "What a judge (the Grok bot, Claude through the API, or a fixture) returns for an interpretation packet. Every label is a term id from the closed vocabulary or the literal 'unclear'. A judge never writes a number. Observations are free text that never becomes a claim.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "judge", "asset_id", "packet_hash", "vocabulary_version", "shots"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "judge": {"type": "string", "enum": ["grok", "anthropic", "fixture"]},
    "model": {"type": ["string", "null"], "description": "Exact model id that produced the answer, when known."},
    "asset_id": {"type": "string", "pattern": "^ref_[0-9a-f]{12}$"},
    "packet_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "vocabulary_version": {"type": "string"},
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shot_id", "dimensions"],
        "properties": {
          "shot_id": {"type": "string", "pattern": "^s[0-9]{3,}$"},
          "dimensions": {"$ref": "#/$defs/dimension_map"}
        }
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"dimensions": {"$ref": "#/$defs/dimension_map"}}
    }
  },
  "$defs": {
    "dimension_map": {
      "type": "object",
      "description": "Keys are dimension ids listed in the packet; values are the judge's label for that dimension.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["terms", "evidence_ids"],
        "properties": {
          "terms": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {"type": "string", "pattern": "^[a-z0-9_]+$"},
            "description": "Term ids of this dimension, or exactly ['unclear'] to abstain."
          },
          "evidence_ids": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Evidence ids from the packet that support the label. Required and non-empty unless terms is ['unclear']."
          },
          "alternatives": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}, "maxItems": 4},
          "observation": {"type": "string", "maxLength": 160}
        }
      }
    }
  }
}
